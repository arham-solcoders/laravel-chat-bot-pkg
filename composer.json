{
    "name": "db-chatbot/laravel",
    "description": "Rule-based database chatbot for Laravel, with PDF and Word reports.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.1",
        "illuminate/auth": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "phpoffice/phpword": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "DbChatbot\\": "src/",
            "DbChatbot\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "DbChatbot\\DbChatbotServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
